MAILER_PORT=
MAILER_USERNAME=""
MAILER_PASSWORD=""
MAILER_ENCRYPTION=""
SENDER_EMAIL=""
SENDER_NAME="PRESSURE RECORD"

# -------------------- Database --------------------
DB_DSN="mysql:host=localhost;port=3306;dbname=project"
DB_USERNAME="user"
DB_PASSWORD="secret"
