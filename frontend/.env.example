# Leave empty when frontend and API are served from the same host.
VITE_API_BASE_URL=

# Used by Vite dev server proxy (for example: php -S localhost:8080 -t ../web).
VITE_API_PROXY=http://localhost:8080

# Six-month early access deadline. Change this value before public launch.
VITE_EARLY_ACCESS_DEADLINE=2027-05-23T23:59:59+03:00
